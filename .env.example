# Copy to .env and fill in. The real .env is gitignored — never commit it.
OPENAI_API_KEY=sk-...

# W5: the system prompt the API serves (pairwise 001 winner)
PIPELINE_SYSTEM_PROMPT_FILE=data/prompt-v2.txt

# W6: naive RAG. Build the index first: python scripts/build_index.py
# Unset = no retrieval (W5 behaviour).
PIPELINE_RAG_INDEX=data/index/medium
# PIPELINE_RAG_K=3

# W7: Qdrant (Cloud free tier: cloud.qdrant.io). Migrate first: python scripts/migrate_to_qdrant.py
# then point the app at the collection instead of the NumPy index:
# PIPELINE_RAG_INDEX=qdrant:capstone_chunks
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=...
# PIPELINE_QDRANT_HNSW_EF=256      # search effort; 0 = exact search
